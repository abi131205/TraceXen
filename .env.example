# TraceXen Environment Configuration Template
# Copy this file to .env locally. NEVER commit real credentials to version control.

# TigerGraph Credentials
TG_HOST=https://savanna.tgcloud.io
TG_SECRET=your_tigergraph_secret_here
TG_GRAPHNAME=TraceXenGraph

# LLM Provider Configuration (gemini or openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# FastAPI Configuration
PORT=8000
ENVIRONMENT=development
